# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Optional external PostgreSQL persistence (app manages accounts & admin independently)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin Dashboard Credentials (Server-side only)
ADMIN_USERNAME=admin
ADMIN_PASSCODE=
